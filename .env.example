# Server
PORT=8787
# Anthropic API key. Leave empty to run with the built-in mock DM.
ANTHROPIC_API_KEY=
# "anthropic" or "mock". Defaults to anthropic when a key is set, mock otherwise.
DM_PROVIDER=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
DM_EFFORT=medium
DATABASE_PATH=./data/dmai.db

# The app's EXPO_PUBLIC_API_URL goes in apps/mobile/.env (see apps/mobile/.env.example).
# Serve the exported web app (pnpm build:web) from the API server.
WEB_DIST=
