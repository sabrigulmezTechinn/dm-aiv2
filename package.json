{
  "name": "dm-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AI Dungeon Master for D&D 5e — mobile and web",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev:server": "pnpm --filter @dmai/server dev",
    "dev:app": "pnpm --filter @dmai/mobile start",
    "dev:web": "pnpm --filter @dmai/mobile web",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
